{
  "name": "sortiva",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "typecheck": "pnpm -r --workspace-concurrency=4 run typecheck",
    "lint": "eslint .",
    "lint:prove": "node scripts/prove-lint.mjs",
    "test": "vitest run",
    "eval": "vitest run --config vitest.eval.config.ts",
    "chaos": "vitest run --config vitest.chaos.config.ts",
    "e2e": "pnpm --filter @sortiva/web exec playwright test",
    "build": "pnpm --filter @sortiva/web run build",
    "smoke:boot": "node scripts/smoke-boot.mjs",
    "dev": "node scripts/dev.mjs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @sortiva/db run db:migrate",
    "db:generate": "pnpm --filter @sortiva/db run db:generate",
    "db:seed": "tsx scripts/seed-dev-db.mjs",
    "env:check": "node scripts/check-env-sync.mjs",
    "posthog:check": "tsx scripts/posthog-provision.mjs --check",
    "contracts:check": "tsx scripts/contracts-check.mjs",
    "stubs:report": "tsx scripts/stub-report.mjs",
    "diagnose": "tsx scripts/diagnose-store.mjs",
    "dlq": "tsx scripts/replay-dlq.mjs",
    "posthog:apply": "tsx scripts/posthog-provision.mjs --apply",
    "switch": "tsx scripts/kill-switch.mjs",
    "comp": "tsx scripts/comp-account.mjs",
    "rules": "tsx scripts/rules-override.mjs",
    "smoke:dev": "node scripts/smoke-boot.mjs --dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-plugin-sortiva": "workspace:*",
    "globals": "^15.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
