{
  "name": "sortiva",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait postgres",
    "db:reset": "tsx db/reset.ts",
    "worker": "tsx jobs/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit && vitest run connectors/shopify/queries.test.ts",
    "shopify:schema": "tsx fakes/fake-shopify/schema/fetch.ts",
    "shopify:capture-demo": "tsx fakes/fake-shopify/captures/capture-public-demo.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "dev": "shopify app dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "preview": "DEV_BYPASS=1 react-router dev",
    "seed:preview": "tsx scripts/seed-preview.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@react-router/dev": "7.18.2",
    "@react-router/fs-routes": "7.18.2",
    "@react-router/node": "7.18.2",
    "@react-router/serve": "7.18.2",
    "graphile-worker": "^0.18.0",
    "graphql": "16",
    "isbot": "^5.2.2",
    "marked": "^18.1.0",
    "pg": "^8.23.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.18.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@shopify/app-bridge-types": "^0.7.2",
    "@shopify/cli": "^4.9.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.3"
  }
}
