# Sortiva — environment variables
#
# tech §4: "no secrets in the repo; `.env.example` documents every required
# variable". `.env` mirrors this file key-for-key with empty values; the two are
# kept in sync — a new key lands in both.
#
# REQUIRED = the app or worker refuses to start without it.
# REQUIRED@<card> = becomes required when that milestone card lands.

# ── Core runtime ─────────────────────────────────────────────────────────────
# REQUIRED. Postgres 16 (tech §2). Local: docker compose up -d postgres.
DATABASE_URL=postgres://sortiva:sortiva@localhost:54329/sortiva
# REQUIRED. development | test | production
NODE_ENV=development
# REQUIRED. Public origin, no trailing slash. Used for OAuth redirect URIs.
APP_URL=http://localhost:3000

# ── Secrets & encryption (tech §4) ───────────────────────────────────────────
# REQUIRED@T0.5. Master key wrapping per-row data keys for Shopify/Google tokens.
# 32 bytes, base64. Generate: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=
# Optional. Comma-separated retired master keys, newest first, for key rotation.
ENCRYPTION_MASTER_KEY_PREVIOUS=

# ── Auth (main §4.1, Auth.js) ────────────────────────────────────────────────
# REQUIRED@T1.1. Generate: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Anthropic (main §14.2, §14.7 — reached only through packages/llm) ────────
# REQUIRED@T0.5.
ANTHROPIC_API_KEY=
# Optional. Pin a model per environment, per tier. Must be an explicit id — an
# alias ending in `-latest` or `-preview` is rejected at load.
#
# These reach every model call EXCEPT the draft judge. The judge's model is
# fixed in code and ignores both variables, so setting the strong tier to a
# cheaper model moves the writer and leaves the quality check where it is.
# There is no variable that moves the judge, deliberately.
ANTHROPIC_MODEL_SONNET=
ANTHROPIC_MODEL_HAIKU=

# ── PostHog (main §14.7 — telemetry and alerting only, never the control plane)
# REQUIRED@T0.5. Server-side capture key.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
# REQUIRED@T-ANALYTICS. The same project's key again, and deliberately a
# second variable: this one is written into the page so the browser can report
# what only it can see. Keeping it separate means nothing that looks like a
# secret reaches a browser because two names shared one value.
NEXT_PUBLIC_POSTHOG_KEY=
# REQUIRED@T0.6. Personal API key used by the dashboards-as-code provisioning
# script (check mode in CI). Not used at runtime.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
# Optional. Turns "I could not reach the analytics project" from a note into a
# failure. Set to true wherever the drift check must actually happen — CI and
# deploy, which have the two keys above. Left unset on a developer's machine so
# a workspace with no analytics secrets is not permanently red.
POSTHOG_REQUIRE_LIVE_CHECK=

# ── Stripe (main §4.2, tech §3) ──────────────────────────────────────────────
# REQUIRED@T1.2. Test-mode keys in dev/staging; live keys only in prod.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=

# ── Cloudflare Turnstile (main §3.2 — preview endpoint) ──────────────────────
# REQUIRED@T1.3.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Shopify (main §6.2, tech §4 — read scopes only at install) ───────────────
# REQUIRED@T2.1.
# Our app's own credentials: Dev Dashboard → your app → Settings → "Client ID"
# and "Client secret". Used to exchange a merchant's authorization code for that
# store's access token and to renew it every hour, and to check that callbacks
# and webhooks really came from Shopify. Outside production, leaving either
# blank runs the app against its built-in fake Shopify; in production the app
# refuses to start without them.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Dev store used by the integration smoke suite (tech §6).
SHOPIFY_DEV_STORE_DOMAIN=

# ── Google Search Console (main §6.7, §12.2) ─────────────────────────────────
# REQUIRED@T3.1. Separate OAuth client from AUTH_GOOGLE_* — different scopes,
# different consent screen (read and write consents are separate, invariant 21).
GSC_OAUTH_CLIENT_ID=
GSC_OAUTH_CLIENT_SECRET=
# Test property for the integration suite.
GSC_TEST_PROPERTY=

# ── DataForSEO (main §12.1 — reached only through SeoDataProvider) ───────────
# REQUIRED@T2.6. Real spend only in prod; dev/staging use the test double.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# live | mock — `mock` forces the test double regardless of credentials.
SEO_PROVIDER_MODE=mock

# ── Resend (tech §1.4 — reached only through EmailProvider) ──────────────────
# REQUIRED@T8.2.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Dedicated sending subdomain, SPF+DKIM+DMARC verified before first prod send.
EMAIL_FROM=Sortiva <hello@mail.example.com>

# ── Worker (tech §2, main §14.3) ─────────────────────────────────────────────
# Graphile Worker concurrency. Sized for the 512 MB app service (tech §2.1).
WORKER_CONCURRENCY=4
# Set to `false` on a split-out worker service, or to disable the in-process
# worker during local UI work.
WORKER_ENABLED=true
