    },
    "locales": {
      "type": "object",
      "description": "main §7.10 — per-locale override layer. Keys are BCP-47 language subtags or full tags.",
      "propertyNames": {
        "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/partialLayer"
      }
    }
  },
