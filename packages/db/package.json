{
  "name": "@sortiva/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Schema, migrations, repositories. Every repository method requires an accountId scope.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.2",
    "pg": "^8.13.1",
    "@sortiva/core": "workspace:*"
  },
  "devDependencies": {
    "@sortiva/providers": "workspace:*",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
