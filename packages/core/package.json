{
  "name": "@sortiva/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Domain logic. Cannot import Next, React, or any provider SDK (CLAUDE.md code-structure rules).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@sortiva/providers": "workspace:*",
    "@sortiva/rules": "workspace:*",
    "@types/markdown-it": "^14.2.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "markdown-it": "^15.0.2",
    "tldts": "^7.4.11",
    "zod": "^4.5.4"
  }
}
